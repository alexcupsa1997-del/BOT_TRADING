<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="gateway.sbe"
                   id="1"
                   version="1"
                   semanticVersion="1.0"
                   description="High-Frequency Trading Internal Protocol">
    
    <types>
        <composite name="decimal9" description="Fixed-point decimal with 9 places">
            <type name="mantissa" primitiveType="int64"/>
            <type name="exponent" primitiveType="int8" presence="constant">9</type>
        </composite>
        <enum name="Side" encodingType="char">
            <validValue name="Buy">B</validValue>
            <validValue name="Sell">S</validValue>
        </enum>
        <enum name="OrderType" encodingType="char">
            <validValue name="Limit">L</validValue>
            <validValue name="Market">M</validValue>
        </enum>
    </types>

    <sbe:message name="OrderResult" id="2" description="Execution Report">
        <field name="orderId" id="1" type="int64"/>
        <field name="symbol" id="2" type="int64"/>
        <field name="side" id="3" type="Side"/>
        <field name="price" id="4" type="decimal9"/>
        <field name="quantity" id="5" type="decimal9"/>
    </sbe:message>

    <sbe:message name="MarketData" id="3" description="Market Tick Data">
        <field name="symbol" id="1" type="int64"/>
        <field name="timestamp" id="2" type="int64"/>
        <field name="bid" id="3" type="decimal9"/>
        <field name="ask" id="4" type="decimal9"/>
        <field name="volume" id="5" type="decimal9"/>
        <field name="flags" id="6" type="uint8"/>
    </sbe:message>

</sbe:messageSchema>
