{
    "mcpServers": {
        "blockscout": {
            "serverUrl": "https://mcp.blockscout.com/mcp"
        },
        "stripe": {
            "command": "npx",
            "args": [
                "-y",
                "@stripe/mcp",
                "--tools=all",
                "--api-key=YOUR_STRIPE_SECRET_KEY_HERE"
            ],
            "env": {}
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "playwright-mcp"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ],
            "env": {
                "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY_HERE"
            }
        },
        "bright-data": {
            "command": "npx",
            "args": [
                "-y",
                "@brightdata/mcp"
            ],
            "env": {
                "API_TOKEN": "YOUR_BRIGHTDATA_API_TOKEN_HERE"
            }
        },
        "cloudflare-services": {
            "command": "npx",
            "args": [
                "-y",
                "@ironclads/cloudflare-mcp"
            ],
            "env": {
                "CF_API_TOKEN": "YOUR_CLOUDFLARE_API_TOKEN_HERE",
                "CF_ACCOUNT_ID": "YOUR_CLOUDFLARE_ACCOUNT_ID_HERE"
            }
        },
        "next-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "next-devtools-mcp@latest"
            ]
        },
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "env": {}
        }
    }
}